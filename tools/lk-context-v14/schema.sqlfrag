
-- LK_CONTEXT_SCHEMA_V180214
CREATE TABLE IF NOT EXISTS project_sites (
    id BIGINT UNSIGNED NOT NULL AUTO_INCREMENT,
    project_id BIGINT UNSIGNED NOT NULL,
    name VARCHAR(190) NOT NULL,
    url VARCHAR(1000) NOT NULL,
    host VARCHAR(255) NOT NULL,
    status VARCHAR(30) NOT NULL DEFAULT 'active',
    metrika_counter_ids_json JSON NULL,
    webmaster_host_ids_json JSON NULL,
    source_type VARCHAR(40) NOT NULL DEFAULT 'manual',
    source_id BIGINT UNSIGNED NULL,
    created_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
    updated_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
    PRIMARY KEY (id),
    UNIQUE KEY uniq_project_sites_url (project_id, url(190)),
    KEY idx_project_sites_project (project_id, status),
    KEY idx_project_sites_source (source_type, source_id)
) ENGINE=InnoDB
  DEFAULT CHARSET=utf8mb4
  COLLATE=utf8mb4_unicode_ci;

CREATE TABLE IF NOT EXISTS user_portal_context (
    user_id BIGINT UNSIGNED NOT NULL,
    client_id BIGINT UNSIGNED NULL,
    project_id BIGINT UNSIGNED NOT NULL,
    updated_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
    PRIMARY KEY (user_id),
    KEY idx_user_portal_context_client (client_id),
    KEY idx_user_portal_context_project (project_id)
) ENGINE=InnoDB
  DEFAULT CHARSET=utf8mb4
  COLLATE=utf8mb4_unicode_ci;

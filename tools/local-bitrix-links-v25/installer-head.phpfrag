<?php
declare(strict_types=1);

if (PHP_SAPI !== 'cli') {
    http_response_code(403);
    exit("Запустите через PHP CLI.\n");
}

const LOCAL_LINKS_VERSION = '__LOCAL_LINKS_VERSION__';
const LOCAL_LINKS_MARKER = 'LOCAL_BITRIX_LINKS_V180325';
const LOCAL_LINKS_ASSET_VERSION = '2026080325';
const LOCAL_LINKS_LOOKUP_MARKER = 'LOCAL_BITRIX_PROJECT_LOOKUP_V180325';

function lb25out(string $message = ''): void
{
    fwrite(STDOUT, $message . PHP_EOL);
}

function lb25read(string $path): string
{
    $content = file_get_contents($path);
    if (!is_string($content)) {
        throw new RuntimeException('Не удалось прочитать файл: ' . $path);
    }
    return $content;
}

function lb25write(string $path, string $content): void
{
    $directory = dirname($path);
    if (!is_dir($directory) && !mkdir($directory, 0775, true) && !is_dir($directory)) {
        throw new RuntimeException('Не удалось создать каталог: ' . $directory);
    }
    $temporary = $path . '.tmp.' . bin2hex(random_bytes(5));
    if (file_put_contents($temporary, $content, LOCK_EX) === false) {
        throw new RuntimeException('Не удалось записать временный файл: ' . $temporary);
    }
    if (!rename($temporary, $path)) {
        @unlink($temporary);
        throw new RuntimeException('Не удалось заменить файл: ' . $path);
    }
}

function lb25lint(string $path): void
{
    if (!function_exists('exec')) {
        return;
    }
    $output = [];
    $code = 0;
    exec(
        escapeshellarg(PHP_BINARY) . ' -l ' . escapeshellarg($path) . ' 2>&1',
        $output,
        $code
    );
    if ($code !== 0) {
        throw new RuntimeException(
            'Ошибка PHP-синтаксиса в ' . $path . ':\n' . implode("\n", $output)
        );
    }
}

function lb25tableExists(PDO $pdo, string $table): bool
{
    $stmt = $pdo->prepare(
        'SELECT COUNT(*) FROM information_schema.TABLES
         WHERE TABLE_SCHEMA = DATABASE() AND TABLE_NAME = :table_name'
    );
    $stmt->execute(['table_name' => $table]);
    return (int) $stmt->fetchColumn() > 0;
}

function lb25payload(): array
{
    $encoded = '__LOCAL_LINKS_PAYLOAD_B64__';
    $decoded = base64_decode($encoded, true);
    if (!is_string($decoded) || hash('sha256', $decoded) !== '__LOCAL_LINKS_PAYLOAD_SHA__') {
        throw new RuntimeException('Повреждён пакет локальных связей Bitrix24.');
    }
    $payload = json_decode($decoded, true);
    if (!is_array($payload)) {
        throw new RuntimeException('Не удалось декодировать пакет локальных связей.');
    }
    $result = [];
    foreach ($payload as $key => $item) {
        $content = base64_decode((string) ($item['content'] ?? ''), true);
        if (!is_string($content) || hash('sha256', $content) !== (string) ($item['sha256'] ?? '')) {
            throw new RuntimeException('Повреждён компонент: ' . $key);
        }
        $result[$key] = $content;
    }
    return $result;
}

function lb25bustAsset(string $html, string $asset): array
{
    $quoted = preg_quote($asset, '#');
    $count = 0;
    $result = preg_replace_callback(
        '#(' . $quoted . ')(?:\?[^"\']*)?#',
        static function (array $match) use (&$count): string {
            $count++;
            return $match[1] . '?v=' . LOCAL_LINKS_ASSET_VERSION;
        },
        $html
    );
    return [is_string($result) ? $result : $html, $count];
}

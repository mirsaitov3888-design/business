<?php
declare(strict_types=1);

if (PHP_SAPI !== 'cli') {
    http_response_code(403);
    exit("Запустите через PHP CLI.\n");
}

const LOCAL_MANAGEMENT_VERSION = '__LOCAL_MANAGEMENT_VERSION__';
const LOCAL_MANAGEMENT_MARKER = 'LOCAL_STRUCTURE_MANAGEMENT_V180324';
const LOCAL_MANAGEMENT_SCHEMA_MARKER = 'LOCAL_STRUCTURE_MANAGEMENT_SCHEMA_V180324';
const FINANCE_MENU_MARKER = 'FINANCE_MENU_BOOTSTRAP_V180324';
const LOCAL_MANAGEMENT_ASSET_VERSION = '2026080324';

function lm24out(string $message = ''): void
{
    fwrite(STDOUT, $message . PHP_EOL);
}

function lm24read(string $path): string
{
    $content = file_get_contents($path);
    if (!is_string($content)) {
        throw new RuntimeException('Не удалось прочитать файл: ' . $path);
    }
    return $content;
}

function lm24write(string $path, string $content): void
{
    $directory = dirname($path);
    if (!is_dir($directory) && !mkdir($directory, 0775, true) && !is_dir($directory)) {
        throw new RuntimeException('Не удалось создать каталог: ' . $directory);
    }
    $temporary = $path . '.tmp.' . bin2hex(random_bytes(5));
    if (file_put_contents($temporary, $content, LOCK_EX) === false) {
        throw new RuntimeException('Не удалось записать временный файл: ' . $temporary);
    }
    if (!rename($temporary, $path)) {
        @unlink($temporary);
        throw new RuntimeException('Не удалось заменить файл: ' . $path);
    }
}

function lm24lint(string $path): void
{
    if (!function_exists('exec')) {
        return;
    }
    $output = [];
    $code = 0;
    exec(escapeshellarg(PHP_BINARY) . ' -l ' . escapeshellarg($path) . ' 2>&1', $output, $code);
    if ($code !== 0) {
        throw new RuntimeException('Ошибка PHP-синтаксиса в ' . $path . ': ' . implode("\n", $output));
    }
}

function lm24payload(): array
{
    $encoded = '__LOCAL_MANAGEMENT_PAYLOAD_B64__';
    $decoded = base64_decode($encoded, true);
    if (!is_string($decoded) || hash('sha256', $decoded) !== '__LOCAL_MANAGEMENT_PAYLOAD_SHA__') {
        throw new RuntimeException('Повреждён пакет локального управления.');
    }
    $payload = json_decode($decoded, true);
    if (!is_array($payload)) {
        throw new RuntimeException('Не удалось декодировать пакет локального управления.');
    }
    $result = [];
    foreach ($payload as $key => $item) {
        $content = base64_decode((string) ($item['content'] ?? ''), true);
        if (!is_string($content) || hash('sha256', $content) !== (string) ($item['sha256'] ?? '')) {
            throw new RuntimeException('Повреждён компонент: ' . $key);
        }
        $result[$key] = $content;
    }
    return $result;
}

function lm24execSchema(PDO $pdo, string $schema): void
{
    $schema = preg_replace('/^\s*--.*$/m', '', $schema) ?? $schema;
    $statements = preg_split('/;\s*(?:\r?\n|$)/', $schema) ?: [];
    foreach ($statements as $statement) {
        $statement = trim($statement);
        if ($statement !== '') {
            $pdo->exec($statement);
        }
    }
}

function lm24bustAsset(string $html, string $asset): array
{
    $quoted = preg_quote($asset, '#');
    $count = 0;
    $result = preg_replace_callback(
        '#(' . $quoted . ')(?:\?[^"\']*)?#',
        static function (array $match) use (&$count): string {
            $count++;
            return $match[1] . '?v=' . LOCAL_MANAGEMENT_ASSET_VERSION;
        },
        $html
    );
    return [is_string($result) ? $result : $html, $count];
}

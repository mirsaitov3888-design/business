<?php
declare(strict_types=1);

if (PHP_SAPI !== 'cli') {
    http_response_code(403);
    exit("Запустите через PHP CLI.\n");
}

const SITE_ONBOARDING_VERSION = '__SITE_ONBOARDING_VERSION__';
const SITE_ONBOARDING_MARKER = 'SITE_ONBOARDING_V180323';
const SITE_ONBOARDING_ASSET_VERSION = '2026080323';

function so23out(string $message = ''): void
{
    fwrite(STDOUT, $message . PHP_EOL);
}

function so23read(string $path): string
{
    $content = file_get_contents($path);
    if (!is_string($content)) {
        throw new RuntimeException('Не удалось прочитать файл: ' . $path);
    }
    return $content;
}

function so23write(string $path, string $content): void
{
    $directory = dirname($path);
    if (!is_dir($directory) && !mkdir($directory, 0775, true) && !is_dir($directory)) {
        throw new RuntimeException('Не удалось создать каталог: ' . $directory);
    }
    $temporary = $path . '.tmp.' . bin2hex(random_bytes(5));
    if (file_put_contents($temporary, $content, LOCK_EX) === false) {
        throw new RuntimeException('Не удалось записать временный файл: ' . $temporary);
    }
    if (!rename($temporary, $path)) {
        @unlink($temporary);
        throw new RuntimeException('Не удалось заменить файл: ' . $path);
    }
}

function so23lint(string $path): void
{
    if (!function_exists('exec')) {
        return;
    }
    $output = [];
    $code = 0;
    exec(
        escapeshellarg(PHP_BINARY) . ' -l ' . escapeshellarg($path) . ' 2>&1',
        $output,
        $code
    );
    if ($code !== 0) {
        throw new RuntimeException(
            'Ошибка PHP-синтаксиса в ' . $path . ':\n' . implode("\n", $output)
        );
    }
}

function so23payload(): array
{
    $encoded = '__SITE_ONBOARDING_PAYLOAD_B64__';
    $decoded = base64_decode($encoded, true);
    if (!is_string($decoded) || hash('sha256', $decoded) !== '__SITE_ONBOARDING_PAYLOAD_SHA__') {
        throw new RuntimeException('Повреждён пакет подключения сайта.');
    }
    $payload = json_decode($decoded, true);
    if (!is_array($payload)) {
        throw new RuntimeException('Не удалось декодировать пакет подключения сайта.');
    }
    $result = [];
    foreach ($payload as $key => $item) {
        $content = base64_decode((string) ($item['content'] ?? ''), true);
        if (!is_string($content) || hash('sha256', $content) !== (string) ($item['sha256'] ?? '')) {
            throw new RuntimeException('Повреждён компонент подключения сайта: ' . $key);
        }
        $result[$key] = $content;
    }
    return $result;
}

function so23bustAsset(string $content, string $asset): array
{
    $pattern = '#(' . preg_quote($asset, '#') . ')(?:\?[^"\'\s<>]*)?#i';
    $updated = preg_replace_callback(
        $pattern,
        static fn(array $match): string =>
            $match[1] . '?v=' . SITE_ONBOARDING_ASSET_VERSION,
        $content,
        -1,
        $count
    );
    if (!is_string($updated)) {
        throw new RuntimeException('Не удалось обновить версию ресурса ' . $asset . '.');
    }
    return [$updated, (int) $count];
}
